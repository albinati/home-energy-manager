# Fox ESS Cloud — foxesscloud.com → API Management (FOXESS_API_KEY or FOX_API_KEY)
FOXESS_API_KEY=
FOXESS_DEVICE_SN=
# DATALOGGER_SERIAL_NUMBER=
# INVERTER_SERIAL_NUMBER=
# Open API version carrying the scheduler WRITE (#777). Default v2: Fox broke
# /op/v3/device/scheduler/enable on 2026-08-06 — it returns 41200 for every
# payload while v0/v1/v2 accept the same groups and the v3 READ stays healthy.
# Set v3 to restore the legacy route once FoxESS fixes it.
# FOX_SCHEDULER_WRITE_VERSION=v2
# Open API version carrying the scheduler READ (#778). Default v2: the v3 read
# omits every `enable: 0` slot, so a device holding 8 reported 1 and three
# consumers compared against a partial view. `groups` still exposes only ACTIVE
# slots on either route, so this is a visibility change, not a behaviour one.
# FOX_SCHEDULER_READ_VERSION=v2

# Daikin Onecta OAuth2 — https://developer.cloud.daikineurope.com
DAIKIN_CLIENT_ID=
DAIKIN_CLIENT_SECRET=
DAIKIN_REDIRECT_URI=http://localhost:8080/callback
DAIKIN_TOKEN_FILE=.daikin-tokens.json
# HTTP 429 retries (default 3). Set 0 to fail fast on rate limits.
# DAIKIN_HTTP_429_MAX_RETRIES=3

# Energy providers
OCTOPUS_API_KEY=
OCTOPUS_ACCOUNT_NUMBER=
OCTOPUS_MPAN_1=
OCTOPUS_METER_SN_1=
OCTOPUS_MPAN_2=
OCTOPUS_METER_SN_2=
OCTOPUS_GSP=

# Forecast source — leave default (open_meteo) until Quartz creds + client_id
# are configured below. Switching ``FORECAST_SOURCE=quartz`` flips the LP /
# heartbeat / replay path to Quartz direct PV (Open-Meteo still supplies
# temperature + cloud context). API docs: https://api.quartz.solar/docs
# FORECAST_SOURCE=open_meteo|quartz
# QUARTZ_AUTH_URL=https://nowcasting-pro.eu.auth0.com/oauth/token
# QUARTZ_API_BASE_URL=https://api.quartz.solar
# Vendor-issued OAuth client_id; supply via .env (NOT committed):
# QUARTZ_CLIENT_ID=
# QUARTZ_AUDIENCE=https://api.nowcasting.io/
# QUARTZ_USERNAME=
# QUARTZ_PASSWORD=
# Legacy aliases also accepted by the code:
# QUARTZ_USER=
# QUARTZ_PASS=
# Optional Quartz site/GSP context:
# QUARTZ_GSP_ID=
# QUARTZ_MODEL_NAME=blend
# QUARTZ_TREND_ADJUSTER_ON=true
# QUARTZ_INSTALLED_CAPACITY_MW=0

# Manual tariff (p/kWh) — Agile example: E-1R-AGILE-24-10-01-<GSP>
MANUAL_TARIFF_IMPORT_PENCE=0
MANUAL_TARIFF_EXPORT_PENCE=0
MANUAL_STANDING_CHARGE_PENCE_PER_DAY=0

# Gas comparison (Insights)
GAS_PRICE_PENCE_PER_KWH=0
GAS_BOILER_EFFICIENCY=0.9
HEAT_PUMP_COP_ESTIMATE=2.8
HEATING_LOAD_SHARE=0.4

# Agile scheduler (Daikin LWT by price) — optional
SCHEDULER_ENABLED=false
OCTOPUS_TARIFF_CODE=
# Tariff structure (#804). auto = detect a BANDED tariff (<= 4 distinct price
# levels, e.g. Cosy's cheap/day/peak) and classify by band MIDPOINTS; Agile
# (many levels) keeps the percentile path. dynamic = kill switch (pre-#804).
OCTOPUS_TARIFF_STRUCTURE=auto
TARIFF_BANDED_MAX_LEVELS=4
TARIFF_BANDED_MIN_SLOTS=12
TARIFF_BAND_CONTRAST_RATIO=1.25
TARIFF_BAND_PRIOR_WINDOW_DAYS=7
TARIFF_DISPLAY_NAME=
# Battery policy (#806): false = battery never discharges to the grid (any
# preset); PV surplus still exports. Prod: false for autumn/winter.
LP_BATTERY_EXPORT_ENABLED=true
# Soft p/kWh penalty on grid import inside the PEAK band (banded tariffs). Prod: 100.
LP_PEAK_IMPORT_PENALTY_PENCE_PER_KWH=0
# #818 — probabilistic load on a banded tariff: floor the SoC at EVERY cheap→non-cheap exit
# (07:00 after 04–07, midnight after 22–24) besides the 16:00 peak entry; and which residual-
# load quantile the pessimistic scenario uses inside day/peak bands (p75 ≈ band p90; p90 over-insures).
LP_PESS_CHARGE_FLOOR_BAND_EXITS=true                # only effective under LP_PESS_CHARGE_FLOOR_SCOPE=peak_entry (prod)
# DB-backed runtime setting since #832 (PUT /api/v1/settings): this env value is only the DEFAULT.
LP_LOAD_EXPENSIVE_BAND_QUANTILE=p75
# #832 weekly fine-tuning review — SUGGESTIONS ONLY, never applied (Sunday 09:00 local).
TUNING_REVIEW_ENABLED=true
TUNING_REVIEW_DOW=6                  # Mon=0 .. Sun=6
TUNING_REVIEW_HOUR_LOCAL=9
TUNING_REVIEW_DAYS=7
TUNING_REVIEW_MIN_DAYS=3             # skip when fewer replayable days
TUNING_REVIEW_CADENCE=stride:4       # replay_day cadence per variant-day
TUNING_REVIEW_MIN_SAVING_PENCE=5     # p/week bar for "recommended"
TUNING_REVIEW_COMFORT_TOLERANCE_H=0.5
# Heartbeat peak-import guard: alert once per peak window + replan.
PEAK_IMPORT_GUARD_ENABLED=true
PEAK_IMPORT_GUARD_KW=0.3
PEAK_IMPORT_GUARD_TICKS=2
PEAK_IMPORT_GUARD_ACTION=replan
# Start of HEM-managed smart-tariff history (period PnL clamp). Alias: AGILE_TARIFF_START_DATE.
SMART_TARIFF_START_DATE=
# Banded tariffs: which band tiers get a family-calendar event (#805).
GOOGLE_CALENDAR_BANDED_TIERS=band_cheap,band_peak
# Daikin cadence (#809): bounded heartbeat refresh (prod: true) + post-write verify.
DAIKIN_HEARTBEAT_REFRESH_ENABLED=false
DAIKIN_HEARTBEAT_REFRESH_SECONDS=1800
DAIKIN_HEARTBEAT_REFRESH_MIN_HEADROOM=40
DAIKIN_POST_WRITE_VERIFY_ENABLED=true
DAIKIN_POST_WRITE_VERIFY_SECONDS=120
# Thermal control (#808). W3 thermal model in the LP (needs a fresh indoor
# sensor reading + DAIKIN_CONTROL_MODE=active). DAIKIN_LWT_SOURCE is a RUNTIME
# setting (tier | lp) — set via PUT /api/v1/settings, not here. So are
# INDOOR_COMFORT_AGGREGATE (mean|min|max|room:<name>), LP_W3_NIGHT_FLOOR_C and
# LP_W3_PEAK_COAST_DELTA_C (#820): PUT /api/v1/settings, not .env.
LP_W3_TIN_ENABLED=false
# Model-consistent UA (W/K); prod pins 200 until fit_ua_hdd learns (see CLAUDE.md #808).
BUILDING_UA_W_PER_K=200
LP_W3_IMPLAUSIBLE_BELOW_FLOOR_C=2.0
# LP_W3_PEAK_COAST_DELTA_C: runtime setting (default 1.0) — see note above.
# LP_W3_CEILING_C (#841): runtime setting (default 23.0, >= setpoint + 0.5) —
# W3 soft comfort ceiling + reference of the LWT boost guard. PUT /api/v1/settings.
DAIKIN_LWT_LP_OFFSET_MIN=-5
DAIKIN_LWT_LP_OFFSET_MAX=5
# #847: demand-gate hysteresis — keep the gate open this many hours after it was
# last measured open (unless outdoor >= DAIKIN_LWT_PREHEAT_OUTDOOR_CUTOFF_C). 0 = off.
DAIKIN_LWT_PREHEAT_DEMAND_HOLD_HOURS=24
# #847: demand-gate hysteresis — keep the gate open this many hours after it was
# last measured open (unless outdoor >= DAIKIN_LWT_PREHEAT_OUTDOOR_CUTOFF_C). 0 = off.
DAIKIN_LWT_PREHEAT_DEMAND_HOLD_HOURS=24
# #838 — coast slots (LP plans no space heat): setback (default, fixed
# DAIKIN_LWT_PREHEAT_PEAK_SETBACK_C) | lp (physics target: LWT = predicted indoor +
# DAIKIN_LWT_COAST_DELTA_C, offset vs the weather curve, clamped to
# [DAIKIN_LWT_LP_OFFSET_MIN, 0]) | lp_raw (LP's raw inverse-physics offset = the range
# minimum on coast slots; experiments). Runtime setting: PUT /api/v1/settings
# DAIKIN_LWT_COAST_MODE (the env value is only the default).
DAIKIN_LWT_COAST_MODE=setback
DAIKIN_LWT_COAST_DELTA_C=2.0
# Real-time comfort backstop: negative-offset row active + live indoor under the
# current floor - margin for N consecutive heartbeats -> offset 0 now + replan.
LWT_COMFORT_BACKSTOP_ENABLED=true
LWT_COMFORT_BACKSTOP_MARGIN_C=0.5
LWT_COMFORT_BACKSTOP_TICKS=2
# After the backstop fires, no NEGATIVE offset may start before now + this many minutes
# (stops the backstop <-> replan oscillation); persisted in kv_state across restarts.
LWT_COMFORT_BACKSTOP_HOLD_MINUTES=90
# Absolute LWT ceiling on the LP heating path (backup-heater exposure): offsets are
# capped so curve_lwt + offset <= this; the LP's space ceiling mirrors it.
DAIKIN_LWT_ABS_MAX_C=45
# Per-slot lwt_learning_log + nightly UA/k estimate (04:40 UTC); retention in days.
LWT_LEARNING_ENABLED=true
LWT_LEARNING_RETENTION_DAYS=120
SCHEDULER_CHEAP_THRESHOLD_PENCE=12
SCHEDULER_PEAK_START=16:00
SCHEDULER_PEAK_END=19:00
SCHEDULER_PREHEAT_LWT_BOOST=2

# API server
API_HOST=0.0.0.0
API_PORT=8000
FOXESS_ALERT_LOW_SOC=10
DAIKIN_ALERT_TEMP_DEVIATION=2
# true = read-only for OpenClaw agents; false allows execute endpoints
OPENCLAW_READ_ONLY=true

# Optimization engine (room/DHW targets; export product for LP/analytics)
OPTIMIZATION_PRESET=normal
# Daikin control mode (v10): passive = service never writes to Daikin, treats it
# as a fixed thermal load (firmware autonomous). active = legacy v9 control path.
# Flip via PUT /api/v1/settings/DAIKIN_CONTROL_MODE without restart.
DAIKIN_CONTROL_MODE=passive
TARGET_ROOM_TEMP_MIN_C=20.0
TARGET_ROOM_TEMP_MAX_C=23.0
TARGET_DHW_TEMP_MIN_NORMAL_C=45.0
TARGET_DHW_TEMP_MIN_GUESTS_C=48.0
TARGET_DHW_TEMP_MAX_C=65.0
# LP building model: unoccupied indoor floor (°C) — see docs/phase2-epic-tasks.md (#21)
# LP_OVERNIGHT_COMFORT_FLOOR_C was REMOVED (Phase B) with the LP comfort-slack vars.

# DHW plunge-pricing policy (issue #50):
#   DHW_TEMP_COMFORT_C is the tank ceiling for positive-price slots (normal comfort target).
#   DHW_TEMP_MAX_C is the plunge-only ceiling (LP allows tank > 48 °C only when price < 0).
# DHW_TEMP_COMFORT_C=48.0
# DHW_TEMP_MAX_C=65.0

# Legionella thermal-shock awareness. The Daikin Onecta firmware fires the cycle
# autonomously on a user-configured day/hour (set in the Onecta app); the LP cannot
# command it. Setting these tells the LP to PREDICT the resulting DHW pulse and
# allocate PV/battery/grid around it. DAY=-1 disables the prediction. All four
# keys are also exposed via PUT /api/v1/settings + MCP set_setting (no restart).
# DAY: 0=Mon, 1=Tue, 2=Wed, 3=Thu, 4=Fri, 5=Sat, 6=Sun.
# DHW_LEGIONELLA_DAY=-1
# DHW_LEGIONELLA_HOUR_LOCAL=13
# DHW_LEGIONELLA_DURATION_MIN=60
# DHW_LEGIONELLA_TANK_TARGET_C=60

# Anti-sauna LWT cap (issue #50): reduce radiator overshoot during max_heat to +5 °C.
# OPTIMIZATION_LWT_OFFSET_MAX=5
# LWT_OFFSET_MAX=5

# ── Hardware constraints (immutable physical limits) ────────────────────────
# Set these to match your installed inverter, battery and DNO connection. They
# bound the LP and dispatcher; they are NOT user preferences. Defaults in
# src/config.py are generic — your .env should be authoritative.
# Inverter (Fox H1 family example below; check your model's datasheet):
#   MAX_INVERTER_KW          — battery DC throughput (continuous), bounds LP
#                              chg[i] / dis[i]. Use the continuous rating.
#   FOX_FORCE_CHARGE_MAX_PWR — AC import ceiling (W). LP fuse_kwh source AND
#                              dispatcher ForceCharge fdPwr clamp. Use the
#                              inverter's nameplate AC, NOT the FoxESS app's
#                              configurable range (which is family-wide).
# Battery:
#   BATTERY_CAPACITY_KWH     — nominal kWh from datasheet (e.g. EP11 = 10.36).
# DNO connection:
#   FOX_EXPORT_MAX_PWR       — battery → grid ceiling (W). Bound by the DNO
#                              standard, NOT inverter nameplate. UK G98 1φ =
#                              16 A × 230 V ≈ 3680. G98 3φ / G99 raise this.
# MAX_INVERTER_KW=5.0
# FOX_FORCE_CHARGE_MAX_PWR=5000
# FOX_EXPORT_MAX_PWR=3680
# BATTERY_CAPACITY_KWH=10.36

# Morning-shower DHW floor disabled by default — family showers in the evening.
# Set to "07:00" (or similar HH:MM) to re-enable a morning DHW demand floor.
# LP_SHOWER_MORNING_LOCAL=

# Dispatch-layer guard on peak_export. Default 0 = observation-only (margin
# values recorded in dispatch_decisions for audit, no slots dropped). Raise
# only after ≥14 days of replay confirms the implied drops do not hurt PnL.
# LP_PEAK_EXPORT_MIN_MARGIN_PENCE_PER_KWH=0.0
# Optional battery-wear shadow cost (p/kWh throughput) folded into the
# peak_export margin check. Story #185 tracks proper wear tracking; leave 0
# until that lands.
# LP_BATTERY_WEAR_COST_PENCE_PER_KWH=0.0

# Nightly plan push: UTC (anchored to Daikin quota rollover at 00:00 UTC).
# LP_PLAN_PUSH_HOUR=0
# LP_PLAN_PUSH_MINUTE=5

# Live deviation triggers (actual Fox realtime vs expected LP/forecast).
# These complement forecast_revision (forecast-vs-forecast) with
# actual-vs-expected checks for fast replans.
# MPC_LIVE_PV_KW_THRESHOLD=1.0
# MPC_LIVE_LOAD_KW_THRESHOLD=1.0
# MPC_LIVE_DEVIATION_HYSTERESIS_TICKS=2

# LP COP pre-processing (#29): 0 = outdoor-only COP curve (legacy). >0 penalises high LWT−T_out lift.
# LP_COP_LIFT_PENALTY_PER_KELVIN=0
# LP_COP_LIFT_REFERENCE_DELTA_K=25
# LP_COP_LIFT_MIN_MULTIPLIER=0.5
# LP_COP_DHW_LIFT_SUPPLY_C=45
# LP_COP_SPACE_LWT_CEILING_C=50

# Heat pump electrical cap in MILP (kW)
# DAIKIN_MAX_HP_KW=2.0
MIN_SOC_RESERVE_PERCENT=15.0
OCTOPUS_EXPORT_TARIFF_CODE=

# ── API Quota & Cache ────────────────────────────────────────────────────────
DAIKIN_DAILY_BUDGET=180
DAIKIN_DEVICES_CACHE_TTL_SECONDS=1800
DAIKIN_FORCE_REFRESH_MIN_INTERVAL_SECONDS=300
DAIKIN_SLOT_TRANSITION_WINDOW_SECONDS=300
# Local morning / afternoon Daikin calibration refresh windows (Europe/London).
DAIKIN_CALIBRATION_WINDOWS_LOCAL=06:00-08:00,14:30-16:30

FOX_DAILY_BUDGET=1200
FOX_REALTIME_CACHE_TTL_SECONDS=300
FOX_FORCE_REFRESH_MIN_INTERVAL_SECONDS=60

# OpenClaw Gateway — all user notifications POST here (see docs/RUNBOOK.md)
# Legacy ALERT_OPENCLAW_URL / ALERT_CHANNEL are not used; remove if still in an old .env.
OPENCLAW_NOTIFY_ENABLED=true
OPENCLAW_NOTIFY_CHANNEL=telegram
OPENCLAW_NOTIFY_TARGET=
# In Docker, openclaw.host is mapped via extra_hosts in deploy/compose.yaml to
# 172.30.0.1 — the gateway of the pinned hem-net bridge. OpenClaw must be
# configured with gateway.bind=lan (binds 0.0.0.0; reachable on loopback,
# Tailscale, and the docker bridge) — loopback-only leaves it unreachable
# from inside the container. The host's public NIC is sealed at netfilter
# (hem-firewall.service) so bind=lan does not expose it to the Internet.
OPENCLAW_HOOKS_URL=http://openclaw.host:18789/hooks/agent
OPENCLAW_HOOKS_TOKEN=
OPENCLAW_HOOKS_TIMEOUT_SECONDS=30
OPENCLAW_HOOKS_AGENT_ID=
OPENCLAW_INTERNAL_API_BASE_URL=http://127.0.0.1:8000
# Daikin schedule windows: minimum half-hour slots (2 = 1 hour minimum)
DAIKIN_MIN_WINDOW_SLOTS=2
# Plan approval / regen (bulletproof + planner)
# PLAN_AUTO_APPROVE=true means freshly proposed plans go live immediately.
# Set to false to require explicit confirm_plan / reject_plan per cycle; the
# PLAN_PROPOSED hook advertises PLAN_APPROVAL_TIMEOUT_SECONDS to OpenClaw, which
# renders Telegram/Discord accept/reject buttons that default to accept on timeout.
PLAN_AUTO_APPROVE=true
PLAN_APPROVAL_TIMEOUT_SECONDS=300
PLAN_REGEN_COOLDOWN_SECONDS=300
# Minimum interval between plan_proposed notifications, even when the plan
# content changes. Prevents MPC re-plan spam on Telegram/Discord — the plan
# still upserts and auto-applies, only the outbound hook is suppressed.
# 0 disables. Default 3600 s (60 min).
PLAN_NOTIFY_MIN_INTERVAL_SECONDS=3600

# ── Epic 13b — UI container bearer auth + CORS ─────────────────────────────
# OpenClaw → /mcp bearer (auto-generated by lifespan on first boot if absent;
# read from HEM_OPENCLAW_TOKEN_FILE under data/, bind-mounted on prod):
# HEM_OPENCLAW_TOKEN_FILE=data/.openclaw-token
# HEM_OPENCLAW_TOKEN=                              # leave empty — file wins

# UI container (Epic 13b/B1) → /api/v1/* bearer (auto-minted same way):
# HEM_UI_TOKEN_FILE=data/.hem-ui-token
# HEM_UI_TOKEN=                                    # leave empty — file wins

# Gate flag for the new /api/v1 bearer guard. Default false during the
# B1 → B6 transition so the inline UI keeps working without headers.
# Flip to true once the SPA container is the only /api/v1 consumer (after
# B6 cutover); the OpenClaw token also passes the guard so server-to-server
# flows with that token keep working.
# HEM_UI_AUTH_REQUIRED=false

# CSV of origins allowed by FastAPI CORS — only relevant when the SPA is
# on a different origin from HEM (Tailnet direct case). Bearer header is
# the credential so allow_credentials=false (no cookies).
# HEM_UI_CORS_ORIGINS=http://localhost,http://localhost:8080

# Scoped sensor-ingest token (#540 W1). A NON-admin credential that unlocks
# ONLY an exact POST /api/v1/sensors/indoor — the token an internet-exposed
# ESPHome room sensor carries (via the existing hem-ui Tailscale funnel :8443).
# A leak can only post fake temperatures to that one route, never touch admin.
# Generate: `python -c "import secrets; print(secrets.token_urlsafe(32))"`.
# Empty → feature off (only admin tokens work). Rotate to revoke a device.
# HEM_SENSOR_INGEST_TOKEN=

# ── Optional: bulletproof engine + weather + V9 LP (full local dev) ─────────
# USE_BULLETPROOF_ENGINE=true
# DB_PATH=energy_state.db
# TZ=Europe/London
# BULLETPROOF_TIMEZONE=Europe/London
# HEARTBEAT_INTERVAL_SECONDS=120
# OCTOPUS_FETCH_HOUR=16
# OCTOPUS_FETCH_MINUTE=5
# DAILY_BRIEF_HOUR=8
# DAILY_BRIEF_MINUTE=0
# ENERGY_STRATEGY_MODE was REMOVED (PR C). Setting it is a silent no-op.
# OPTIMIZER_BACKEND=lp
# WEATHER_LAT=51.5
# WEATHER_LON=-0.26
# LP_SOLVER=cbc           # CBC is the only supported backend; setting any
#                         # other value logs a warning and falls back to CBC.
# LP_CBC_TIME_LIMIT_SECONDS=30
# (See prior commits or docs for full LP_* / FOX_LP_* / building model vars.)

# --- Forecast night bias (#324) ---
# LEAVE AT 0. The learned per-hour microclimate offset (forecast_skill_log)
# already corrects the forecast-vs-sensor gap adaptively; a static bias
# DOUBLE-corrects and makes the LP budget every night ~3 °C colder than reality.
FORECAST_NIGHT_TEMP_BIAS_C=0.0

# --- #821 plan/fronts spend score ---
# "ideal" when the day average import price <= ideal (cheapest band / q25) x this ratio.
SPEND_SCORE_IDEAL_RATIO=1.15

# --- Comfort feedback loop (#833) ---
TELEGRAM_INBOUND_ENABLED=false         # owner /conforto via getUpdates; ONLY if the bot token is exclusive to HEM (OpenClaw owns it today)
TELEGRAM_OWNER_USER_ID=                # optional: also require message.from.id to match
TELEGRAM_INBOUND_POLL_SECONDS=60
COMFORT_FEEDBACK_AUTO_TUNE=false       # true = apply the weekly +-0.5 C proposal (night floor / peak coast only)

# --- #831 daily Cosy scorecard (scores yesterday at HOUR:MINUTE local; read-only) ---
COSY_SCORECARD_ENABLED=true
COSY_SCORECARD_HOUR_LOCAL=7
COSY_SCORECARD_MINUTE=30
COSY_SCORECARD_QUOTA_ALERT=150      # one risk alert when yesterday's Daikin calls exceed this
